name: punto-gamer-rabbitmq

x-rabbitmq: &rabbitmq
  image: rabbitmq:4.3.6-management-alpine
  restart: unless-stopped
  mem_limit: 1g
  environment:
    RABBITMQ_DEFAULT_USER: '${username}'
    RABBITMQ_DEFAULT_PASS: '$${RABBITMQ_PASSWORD:?RABBITMQ_PASSWORD is required}'
    RABBITMQ_DEFAULT_VHOST: '${vhost}'
    RABBITMQ_ERLANG_COOKIE: '$${RABBITMQ_ERLANG_COOKIE:?RABBITMQ_ERLANG_COOKIE is required}'
    RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS: '+S 2:2'
  healthcheck:
    test: ['CMD', 'rabbitmq-diagnostics', '-q', 'check_running']
    interval: 15s
    timeout: 10s
    retries: 20
    start_period: 40s
  networks:
    - rabbitmq
  logging:
    driver: json-file
    options:
      max-size: '10m'
      max-file: '3'

services:
  # Los pares deben arrancar para que el cluster recupere su quorum.
  rabbitmq-1:
    <<: *rabbitmq
    hostname: rabbitmq-1
    ports:
      - '5672:5672'
      - '127.0.0.1:15672:15672'
    volumes:
      - rabbitmq_data_1:/var/lib/rabbitmq
      - ./rabbitmq.conf:/etc/rabbitmq/rabbitmq.conf:ro

  rabbitmq-2:
    <<: *rabbitmq
    hostname: rabbitmq-2
    depends_on:
      rabbitmq-1:
        condition: service_started
    ports:
      - '5673:5672'
      - '127.0.0.1:15673:15672'
    volumes:
      - rabbitmq_data_2:/var/lib/rabbitmq
      - ./rabbitmq.conf:/etc/rabbitmq/rabbitmq.conf:ro

  rabbitmq-3:
    <<: *rabbitmq
    hostname: rabbitmq-3
    depends_on:
      rabbitmq-2:
        condition: service_started
    ports:
      - '5674:5672'
      - '127.0.0.1:15674:15672'
    volumes:
      - rabbitmq_data_3:/var/lib/rabbitmq
      - ./rabbitmq.conf:/etc/rabbitmq/rabbitmq.conf:ro

volumes:
  rabbitmq_data_1:
  rabbitmq_data_2:
  rabbitmq_data_3:

networks:
  rabbitmq:
    driver: bridge
