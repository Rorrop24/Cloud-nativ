# Completar con tu cuenta y red existentes. Este archivo no crea una VPC.
aws_account_id = "123456789012"
aws_region     = "us-east-1"
subnet_id      = "subnet-0123456789abcdef0"

# SG de la EC2 donde corre el backend, en la misma VPC.
# Si se deja vacio, se puede administrar por SSM, pero el backend no podra conectarse.
backend_security_group_ids = ["sg-0123456789abcdef0"]

project_name                = "punto-gamer"
environment                 = "dev"
instance_type               = "t3.medium"
volume_size_gib              = 40
associate_public_ip_address = true

# Opcional: fijar una AMI Amazon Linux 2023 x86_64 despues del primer plan.
# ami_id = "ami-0123456789abcdef0"

# Son nombres de parametros existentes en SSM, nunca passwords.
password_parameter_name = "/punto-gamer/dev/rabbitmq/password"
cookie_parameter_name   = "/punto-gamer/dev/rabbitmq/erlang-cookie"

rabbitmq_username = "levelup"
rabbitmq_vhost    = "levelup"

# Si usas una clave KMS propia para los SecureString:
# secrets_kms_key_arn = "arn:aws:kms:us-east-1:123456789012:key/00000000-0000-0000-0000-000000000000"
