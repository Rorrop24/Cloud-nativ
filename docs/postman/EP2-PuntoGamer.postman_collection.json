            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"domain\": \"pedidos\",\n  \"reference\": \"EP2-normal-{{$timestamp}}\",\n  \"message\": \"Prueba normal\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
