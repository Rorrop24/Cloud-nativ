{
  "info": {
    "name": "Punto Gamer EP2 — Rabbit Admin",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Token de acceso con Rabbit.Admin, solo en variable local. Ejecutar recursos en orden; no guardar tokens en Git."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://7wnvd6bgue.execute-api.us-east-1.amazonaws.com"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Topologia",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/rabbitmq/topology",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2 Crear cola",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/rabbitmq/queues",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"queueName\": \"evidencia.ep2\",\n  \"durable\": true,\n  \"queueType\": \"quorum\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
